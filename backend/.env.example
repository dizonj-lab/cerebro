# Copy to backend/.env for local development.
CEREBRO_DATABASE_URL=postgresql+psycopg://cerebro:cerebro_dev_password@localhost:5432/cerebro
CEREBRO_CORS_ORIGINS=http://localhost:3000
CEREBRO_ENVIRONMENT=development
# Required outside development; must be 32+ characters:
#   openssl rand -hex 32
# CEREBRO_JWT_SECRET=

# Object storage. "filesystem" locally, "s3" against MinIO in compose/k8s.
CEREBRO_STORAGE_BACKEND=filesystem
CEREBRO_STORAGE_PATH=./var/artifacts
# CEREBRO_S3_ENDPOINT=localhost:9000
# CEREBRO_S3_BUCKET=cerebro-artifacts
