# Host ports for `docker compose up`. Copy to .env and edit if any of these are
# already taken on your machine — compose reads .env automatically.
#
#   cp .env.example .env
#
# Only the host side of the mapping changes. The containers keep their internal
# ports, and no image rebuild is needed: the browser reaches the API through the
# web origin, not a hard-coded port.

# The app. 3000 is a common conflict (OpenWebUI, other Next.js projects).
CEREBRO_WEB_PORT=3000

# The API. Published only for direct inspection; the app does not need it.
CEREBRO_API_PORT=8000

# PostgreSQL. Conflicts with a PostgreSQL already running on the host.
CEREBRO_DB_PORT=5432
