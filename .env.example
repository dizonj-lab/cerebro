# Host ports for `docker compose up`. Copy to .env and edit if any of these are
# already taken on your machine — compose reads .env automatically.
#
#   cp .env.example .env
#
# Only the host side of the mapping changes. The containers keep their internal
# ports, and no image rebuild is needed: the browser reaches the API through the
# web origin, not a hard-coded port.

# The app. 3000 is a common conflict (OpenWebUI, other Next.js projects).
CEREBRO_WEB_PORT=3000

# The API. Published only for direct inspection; the app does not need it.
CEREBRO_API_PORT=8000

# PostgreSQL. Conflicts with a PostgreSQL already running on the host.
CEREBRO_DB_PORT=5432

# Object storage. The default "filesystem" backend writes to a Docker volume
# and needs no extra container — it is also the backend the test suite covers.
CEREBRO_STORAGE_BACKEND=filesystem

# To use MinIO instead:
#   docker compose --profile minio up -d
#   CEREBRO_STORAGE_BACKEND=s3
#
# No default: minio/minio is 404 on Docker Hub and quay.io returns 401.
# Set this to a reference you can actually pull. See docs/DEVELOPMENT.md.
# CEREBRO_MINIO_IMAGE=
CEREBRO_S3_PORT=9000
CEREBRO_S3_CONSOLE_PORT=9001

# --- Local AI (optional) ---------------------------------------------------
# Both engines run on your own machine through Ollama. There is no cloud
# option. Pull a model first:
#
#   ollama pull llama3.2          # metadata suggestions
#   ollama pull nomic-embed-text  # embeddings for search
#
# Metadata suggestions. Deterministic enrichment (the document's own metadata
# plus statistics over its text) always runs; this adds a local model, asked
# only when you press "Suggest with local AI" on the review screen.
#CEREBRO_ENRICHMENT_LLM=ollama
#CEREBRO_OLLAMA_ENRICHMENT_MODEL=llama3.2

# Embeddings. The default `hashing` provider matches words, not meaning.
# Switching to ollama gives real semantic search — but vectors from the two
# providers are different spaces and are never compared, so anything already
# registered needs re-registering to be found again.
#CEREBRO_EMBEDDING_PROVIDER=ollama
#CEREBRO_OLLAMA_EMBEDDING_MODEL=nomic-embed-text
#CEREBRO_OLLAMA_EMBEDDING_DIMENSIONS=768

# Where Ollama is. The compose default already points at the host from inside
# the container; set this only if Ollama runs somewhere else.
#CEREBRO_OLLAMA_BASE_URL=http://host.docker.internal:11434
